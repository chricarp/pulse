#!/bin/sh
# Stands in for `codex`: ignores its arguments (printed to stderr), consumes the prompt and
# replays a recorded JSONL run. See README.md.
dir=$(dirname "$0")
printf 'argv: %s\n' "$*" >&2
exec "$dir/fake-agent" replay "${FAKE_AGENT_STREAM:-$dir/codex/answer.jsonl}" ${FAKE_AGENT_DELAY:+"$FAKE_AGENT_DELAY"}
