{
  "name": "@pulse/web",
  "private": true,
  "description": "Lictory Pulse: the web UI the daemon serves.",
  "license": "MIT",
  "author": "Christian Carpinelli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chricarp/pulse.git",
    "directory": "apps/web"
  },
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "dev:real": "node scripts/dev-real.mjs",
    "build": "vite build",
    "build:mock": "vite build --mode mock --outDir dist-mock",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint --deny-warnings src e2e e2e-real scripts",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:real": "playwright test -c playwright.real.config.ts",
    "docs:images": "playwright test -c playwright.images.config.ts"
  },
  "dependencies": {
    "@tanstack/react-virtual": "3.14.26",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "26",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "oxlint": "1.93.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
